# Скопируйте в .env и заполните.  Файл .env в git не попадает.
#   cp .env.example .env

# ── Общее ───────────────────────────────────────────────────────────────
# Часовой пояс контейнеров. Должен совпадать с TIME_ZONE в настройках
# Django, иначе время в логах разъедется с временем в админке.
TZ=Asia/Novosibirsk

# ── Django ──────────────────────────────────────────────────────────────
# Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=замените-на-случайную-строку

# DEBUG включает подробные ошибки и открывает CORS для localhost:3000.
# На проде оставьте пустым или напишите PRODUCTION.
ENVIRONMENT=PRODUCTION

# Домены, с которых Django принимает запросы. Через запятую.
# Обязательно добавьте backend — по этому имени в него ходит SSR фронтенда.
DJANGO_ALLOWED_HOSTS=physicsday.ru,www.physicsday.ru,backend,localhost,127.0.0.1

# Публичный адрес сайта. Из него собираются CSRF_TRUSTED_ORIGINS и CORS.
SITE_URL=https://physicsday.ru

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_DB=physicsday
POSTGRES_USER=physicsday
POSTGRES_PASSWORD=замените-на-длинный-пароль
# Внутри docker-compose переопределяются автоматически, менять не нужно.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Frontend ────────────────────────────────────────────────────────────
# Адрес API из БРАУЗЕРА. На проде — относительный путь: nginx отдаёт и сайт,
# и /api с одного домена. В dev — полный адрес, домены разные.
# Внимание: значение вшивается в бандл при сборке образа, менять его
# на работающем контейнере бесполезно — нужна пересборка frontend.
NEXT_PUBLIC_API_BASE_URL=/api

# Адрес API из КОНТЕЙНЕРА frontend при серверном рендере (SSR/ISR).
# Идёт по внутренней docker-сети, мимо nginx и мимо интернета.
API_URL_INTERNAL=http://backend:8000/api
