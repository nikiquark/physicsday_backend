__pycache__/
*.py[cod]
venv/
.venv/
static/
staticfiles/
# Картинки в образ не копируются намеренно: каталог media монтируется
# с хоста (см. volumes в docker-compose.yml), и содержимое образа всё
# равно было бы им перекрыто. Не превращайте это в именованный том —
# он создастся пустым, и Django будет отдавать 404 на каждую картинку.
media/
db.sqlite3
.env
.env.*
